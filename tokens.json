{
  "color": {
    "paper": "#efeee9",
    "ink": "#151515",
    "hero": "#050505",
    "heroInk": "#efeee9",
    "onSignal": "#151515",
    "actionPrimary": "#3f4dff",
    "feedbackWarning": "#ff6547",
    "surfaceRaised": "#e3e1d9",
    "muted": "#6e6d68",
    "faint": "#a5a39b",
    "line": "#c9c7be",
    "panel": "#e3e1d9",
    "signal": "#3f4dff",
    "hot": "#ff6547",
    "acid": "#c9ff36",
    "violet": "#cdbbff"
  },
  "typography": {
    "family": "Siftion UI",
    "tracking.body": "0.01em",
    "tracking.display": "-0.005em",
    "tracking.kicker": "0.08em",
    "weights": [400, 500, 600, 700]
  },
  "layout": {
    "maxWidth": "1440px",
    "gutter": "clamp(1.25rem, 4vw, 4.5rem)",
    "columns": 12,
    "section": "clamp(5rem, 12vw, 11rem)"
  },
  "shape": {
    "controlRadius": "0.25rem",
    "panelRadius": "0"
  },
  "motion": {
    "ease": "cubic-bezier(.2, .8, .2, 1)",
    "fast": "160ms",
    "base": "360ms",
    "slow": "760ms",
    "reducedMotion": "nonessential transitions resolve immediately"
  },
  "grammar": ["field", "signal", "module", "index", "state", "motion"]
}
