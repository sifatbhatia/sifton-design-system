{
  "schemaVersion": "1.0.0",
  "color": {
    "paper": "#efeee9",
    "ink": "#151515",
    "hero": "#050505",
    "heroInk": "#efeee9",
    "onSignal": "#ffffff",
    "onHot": "#151515",
    "signalText": "#3f4dff",
    "warningText": "#a83620",
    "actionPrimary": "#3f4dff",
    "feedbackWarning": "#ff6547",
    "surfaceRaised": "#e3e1d9",
    "muted": "#6e6d68",
    "faint": "#a5a39b",
    "line": "#c9c7be",
    "panel": "#e3e1d9",
    "signal": "#3f4dff",
    "hot": "#ff6547",
    "violet": "#cdbbff",
    "white": "#ffffff",
    "focus": "#3f4dff"
  },
  "themes": {
    "night": {
      "paper": "#151515",
      "ink": "#efeee9",
      "hero": "#050505",
      "heroInk": "#efeee9",
      "onSignal": "#ffffff",
      "onHot": "#151515",
      "signalText": "#9da5ff",
      "warningText": "#ff6547",
      "actionPrimary": "#3f4dff",
      "feedbackWarning": "#ff6547",
      "surfaceRaised": "#22221f",
      "muted": "#aaa89f",
      "faint": "#74736c",
      "line": "#3d3c38",
      "panel": "#22221f",
      "signal": "#3f4dff",
      "hot": "#ff6547",
      "violet": "#cdbbff",
      "white": "#f6f5f0",
      "focus": "#9da5ff"
    }
  },
  "colorSchemes": {"default": "light", "night": "dark"},
  "semanticAliases": {
    "actionPrimary": "signal",
    "feedbackWarning": "hot",
    "focus": "signalText",
    "surfaceRaised": "panel"
  },
  "colorRoles": {
    "signal": "primary actions and selected controls",
    "hot": "warnings, invalid input and actions requiring care",
    "violet": "Reserved accent, not part of the active showcase palette."
  },
  "typography": {
    "family": "Siftion UI",
    "tracking.body": "0.01em",
    "tracking.display": "-0.005em",
    "tracking.kicker": "0.08em",
    "weights": [400, 500, 600, 700],
    "fallbacks": ["ui-sans-serif", "system-ui", "sans-serif"],
    "monoFamily": ["SFMono-Regular", "Consolas", "Liberation Mono", "monospace"],
    "fontVersion": "1.100",
    "fontStyle": "normal",
    "fontDisplay": "swap",
    "fontFaces": [
      {"weight": 400, "src": "../assets/SiftionUI-Regular.woff2", "format": "woff2"},
      {"weight": 500, "src": "../assets/SiftionUI-Medium.woff2", "format": "woff2"},
      {"weight": 600, "src": "../assets/SiftionUI-Semibold.woff2", "format": "woff2"},
      {"weight": 700, "src": "../assets/SiftionUI-Bold.woff2", "format": "woff2"}
    ]
  },
  "layout": {
    "maxWidth": "1440px",
    "gutter": "clamp(1.25rem, 4vw, 4.5rem)",
    "columns": 12,
    "section": "clamp(5rem, 12vw, 11rem)",
    "unit": "clamp(.35rem, .7vw, .75rem)"
  },
  "shape": {
    "controlRadius": "0.25rem",
    "panelRadius": "0",
    "componentRadii": {
      "button": "999px",
      "buttonGhost": "0",
      "buttonIcon": "50%",
      "switchTrack": "99px",
      "switchThumb": "50%",
      "choice": "99px",
      "segmentTrack": "11px",
      "segmentOption": "7px",
      "dialog": "18px",
      "toast": "12px",
      "field": "9px",
      "feedback": "10px",
      "motionRecipe": "12px",
      "split": "12px"
    }
  },
  "motion": {
    "ease": "cubic-bezier(.2, .8, .2, 1)",
    "fast": "160ms",
    "base": "360ms",
    "slow": "760ms",
    "reducedMotion": "nonessential transitions resolve immediately",
    "componentDurations": {
      "interactive": "200ms",
      "field": "180ms",
      "async": "900ms",
      "list": "500ms"
    },
    "componentEasings": {"async": "linear"},
    "reducedMotionOverrides": {
      "fast": "0ms",
      "base": "0ms",
      "slow": "0ms",
      "componentDurations.interactive": "0ms",
      "componentDurations.field": "0ms",
      "componentDurations.async": "0ms",
      "componentDurations.list": "0ms"
    }
  },
  "grammar": ["field", "signal", "module", "index", "state", "motion"]
}
